{
  "hosting": {
    "site": "maiscantoria",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "vercel.json",
      "**/*.bk.jpg",
      "**/*.bk.jpeg",
      "**/*.bk.png",
      "**/*.bk.webp",
      "**/*.bk.gif",
      "home.png",
      "home_nova.png",
      "escolas.png",
      "contato.png",
      "curriculo.png",
      "download-images.sh",
      "download-images.ps1"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "/assets/img/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/assets/@(css|js)/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
        ]
      }
    ]
  }
}
